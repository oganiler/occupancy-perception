# Force LF everywhere. Prevents CRLF from WSL/Windows breaking
# shell scripts and the Docker entrypoint at build time.
* text=auto eol=lf

*.sh        text eol=lf
*.py        text eol=lf
*.md        text eol=lf
*.yaml      text eol=lf
*.yml       text eol=lf
*.txt       text eol=lf
*.cpp       text eol=lf
*.hpp       text eol=lf
Dockerfile  text eol=lf
CMakeLists.txt text eol=lf

*.png  binary
*.jpg  binary
*.npz  binary
*.bin  binary
*.pcd  binary
